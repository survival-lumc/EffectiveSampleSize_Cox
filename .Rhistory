library(here)
# library(tinytex) # Removed to avoid Docx conflicts`
source("C:/Users/thackmann/Research/4. Effective Sample Size Cox/6. Survival Git/code/sim_guardrails.R")
#| label: sim-supplement-16-run
#| include: false
source(here::here("code", "sim_guardrails.R"))
cacheM <- here::here("results", "sim_main.rds")
if (file.exists(cacheM)) {
resM <- readRDS(cacheM)
} else {
resM <- run_all(make_scen("factorial"))
dir.create(dirname(cacheM), showWarnings = FALSE, recursive = TRUE)
saveRDS(resM, cacheM)
}
plM <- plot_main(resM, here::here("results"))     # supplement: columns = C, rows = censoring
plM1 <- plot_main1(resM, here::here("results"))   # main figures: one panel, pooled
#| label: fig-supplement-16-main
#| echo: false
#| fig-cap: "Percentage of predictions with $\\widehat{N}_* > N$ as a function of the true survival probability (logit scale), by overall proportion of patients with an event. Pooled over Harrell's C (0.6 to 0.9), both censoring settings and the seven time points. Dashed line: 5%; labels: true survival at which the line crosses 5%."
plM1$p1$logit
#| label: fig-supplement-16-admin
#| echo: false
#| fig-cap: "As the previous figure, separately for a common end of follow-up and staggered entry (administrative censoring); pooled over Harrell's C. The lines coincide."
plot_admin(resM, here::here("results"))$logit
#| label: fig-supplement-16-coverage-n
#| echo: false
#| fig-cap: "Coverage of the 95% log-log confidence interval against $N/N_*$ (log scale; $N_*$ from the empirical variance over the replications), by overall proportion of patients with an event. Pooled over Harrell's C, censoring and time points. Left of the dotted line: $N_* > N$. The grey band is the range expected from Monte Carlo error alone."
plot_coverage_N(resM, here::here("results"))
